<?xml version="1.0" encoding="UTF-8"?>

<?import java.net.URL?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<ScrollPane fitToWidth="true" xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.snoozeshare.ui.host.listings.HostListingDetailController">
    <stylesheets>
        <URL value="@host-listing-detail.css"/>
    </stylesheets>
    <VBox spacing="18" styleClass="host-listing-detail-page">
        <padding><Insets top="20" right="32" bottom="40" left="32"/></padding>

        <HBox alignment="CENTER_LEFT" spacing="12" styleClass="listing-detail-actions">
            <Hyperlink text="Listings" onAction="#handleBack" styleClass="host-crumb-link"/>
            <Label text="›" styleClass="host-crumb"/>
            <Label fx:id="titleCrumb" styleClass="host-crumb-current"/>
            <VBox HBox.hgrow="ALWAYS"/>
            <Button text="Open booking calendar" onAction="#handleOpenCalendar"
                    styleClass="outline-button"/>
            <Button text="Edit" onAction="#handleEdit"
                    styleClass="listing-detail-action-edit"/>
        </HBox>

        <StackPane prefHeight="200" maxWidth="Infinity"
                   styleClass="listing-detail-image-placeholder"/>

        <GridPane hgap="24" styleClass="listing-detail-content">
            <columnConstraints>
                <ColumnConstraints percentWidth="60"/>
                <ColumnConstraints percentWidth="40"/>
            </columnConstraints>
            <VBox spacing="16" maxWidth="Infinity" GridPane.columnIndex="0">
                <HBox spacing="10" alignment="CENTER_LEFT">
                    <Label fx:id="titleLabel" styleClass="page-title"/>
                    <Label fx:id="typeLabel" styleClass="listing-detail-type-badge"/>
                    <Label fx:id="statusLabel" styleClass="listing-detail-status-badge"/>
                </HBox>
                <Label fx:id="addressLabel" styleClass="listing-detail-address"/>

                <HBox spacing="24" styleClass="listing-detail-stats">
                    <VBox styleClass="listing-detail-stat">
                        <Label fx:id="capacityLabel" styleClass="listing-detail-stat-value"/>
                        <Label text="MAX GUESTS" styleClass="listing-detail-stat-caption"/>
                    </VBox>
                    <VBox styleClass="listing-detail-stat">
                        <Label fx:id="bedroomsLabel" styleClass="listing-detail-stat-value"/>
                        <Label text="BEDROOMS" styleClass="listing-detail-stat-caption"/>
                    </VBox>
                    <VBox styleClass="listing-detail-stat">
                        <Label fx:id="bathroomsLabel" styleClass="listing-detail-stat-value"/>
                        <Label text="BATHROOMS" styleClass="listing-detail-stat-caption"/>
                    </VBox>
                    <VBox styleClass="listing-detail-stat">
                        <Label fx:id="rateLabel" styleClass="listing-detail-stat-value"/>
                        <Label text="PER NIGHT" styleClass="listing-detail-stat-caption"/>
                    </VBox>
                    <VBox styleClass="listing-detail-stat">
                        <Label fx:id="checkInLabel" styleClass="listing-detail-stat-value"/>
                        <Label text="CHECK-IN" styleClass="listing-detail-stat-caption"/>
                    </VBox>
                    <VBox styleClass="listing-detail-stat">
                        <Label fx:id="checkOutLabel" styleClass="listing-detail-stat-value"/>
                        <Label text="CHECK-OUT" styleClass="listing-detail-stat-caption"/>
                    </VBox>
                </HBox>

                <Label fx:id="descriptionLabel" wrapText="true"
                       styleClass="listing-detail-description"/>
                <Label text="AMENITIES" styleClass="listing-detail-section-title"/>
                <FlowPane fx:id="amenitiesPane" hgap="8" vgap="8"
                          styleClass="listing-detail-amenities"/>

                <VBox spacing="10" styleClass="listing-detail-reviews">
                    <Label fx:id="reviewsTitleLabel" styleClass="listing-detail-section-title"/>
                    <VBox fx:id="reviewsList" spacing="10"/>
                </VBox>
            </VBox>

            <VBox spacing="12" maxWidth="Infinity"
                  styleClass="listing-detail-performance" GridPane.columnIndex="1">
                <Label text="Performance" styleClass="listing-detail-performance-title"/>
                <HBox alignment="CENTER_LEFT">
                    <Label text="Total bookings" styleClass="listing-detail-performance-label"/>
                    <VBox HBox.hgrow="ALWAYS"/>
                    <Label fx:id="bookingCountLabel" styleClass="listing-detail-performance-value"/>
                </HBox>
                <HBox alignment="CENTER_LEFT">
                    <Label text="Occupancy (30d)" styleClass="listing-detail-performance-label"/>
                    <VBox HBox.hgrow="ALWAYS"/>
                    <Label fx:id="occupancyLabel" styleClass="listing-detail-performance-value"/>
                </HBox>
                <HBox alignment="CENTER_LEFT">
                    <Label text="Earnings (30d)" styleClass="listing-detail-performance-label"/>
                    <VBox HBox.hgrow="ALWAYS"/>
                    <Label fx:id="earningsLabel" styleClass="listing-detail-performance-value"/>
                </HBox>
            </VBox>
        </GridPane>
    </VBox>
</ScrollPane>
