<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>
<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="agent-scroll, listing-form-scroll"
            fx:controller="com.snoozeshare.ui.host.listings.HostListingFormController"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <stylesheets><URL value="@../host-theme.css"/></stylesheets>
    <content>
        <VBox fx:id="formRoot" styleClass="agent-content, listing-form-page" spacing="16">
            <padding><Insets top="24" right="32" bottom="24" left="32"/></padding>

            <HBox alignment="CENTER_LEFT" spacing="16">
                <Hyperlink text="Listings" onAction="#handleListings" styleClass="host-crumb-link"/>
                <Label text="›" styleClass="host-crumb"/>
                <Hyperlink fx:id="listingCrumb" onAction="#handleListingDetail"
                           styleClass="host-crumb-link" visible="false" managed="false"/>
                <Label fx:id="editSeparator" text="›" styleClass="host-crumb"
                       visible="false" managed="false"/>
                <Label fx:id="formBreadcrumb" text="Create" styleClass="host-crumb-current"/>
            </HBox>
            <Label fx:id="formTitle" text="Create listing" styleClass="page-title"/>

            <GridPane hgap="12" vgap="12" styleClass="listing-form-grid" maxWidth="Infinity">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50" hgrow="SOMETIMES"/>
                    <ColumnConstraints percentWidth="50" hgrow="SOMETIMES"/>
                </columnConstraints>

                <VBox styleClass="listing-form-column" spacing="16" GridPane.columnIndex="0">
                <VBox styleClass="listing-form-card" spacing="8">
                    <Label text="BASIC DETAILS" styleClass="listing-form-card-title"/>
                    <Label text="Title" styleClass="listing-form-label"/>
                    <TextField fx:id="titleField" styleClass="listing-form-field" promptText="e.g. Sunset Loft"/>
                    <Label text="Description" styleClass="listing-form-label"/>
                    <TextArea fx:id="descriptionField" styleClass="listing-description, listing-form-field"
                              promptText="Describe what makes this space special" prefRowCount="3"
                              wrapText="true"/>
                    <HBox spacing="10" fillHeight="true">
                        <VBox styleClass="listing-form-field" spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Property type" styleClass="listing-form-label"/>
                            <ComboBox fx:id="propertyTypeCombo" styleClass="listing-form-control"
                                      maxWidth="Infinity"/>
                        </VBox>
                        <VBox styleClass="listing-form-field" spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Status" styleClass="listing-form-label"/>
                            <ComboBox fx:id="statusCombo" styleClass="listing-form-control"
                                      maxWidth="Infinity"/>
                        </VBox>
                    </HBox>
                </VBox>

                <VBox styleClass="listing-form-card" spacing="8">
                    <Label text="LOCATION" styleClass="listing-form-card-title"/>
                    <Label text="Street address" styleClass="listing-form-label"/>
                    <TextField fx:id="streetAddressField" styleClass="listing-form-field" promptText="e.g. 12 Rua das Flores"/>
                    <HBox spacing="10" fillHeight="true">
                        <VBox styleClass="listing-form-field" spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="City" styleClass="listing-form-label"/>
                            <TextField fx:id="cityField" promptText="e.g. Lisbon"/>
                        </VBox>
                        <VBox styleClass="listing-form-field" spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Region" styleClass="listing-form-label"/>
                            <TextField fx:id="regionField" promptText="e.g. Lisboa"/>
                        </VBox>
                        <VBox styleClass="listing-form-field" spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Postal code" styleClass="listing-form-label"/>
                            <TextField fx:id="postalCodeField" promptText="e.g. 1200"/>
                        </VBox>
                    </HBox>
                </VBox>
                </VBox>

                <VBox styleClass="listing-form-column" spacing="16" GridPane.columnIndex="1">
                <VBox styleClass="listing-form-card" spacing="8">
                    <Label text="CAPACITY &amp; PRICING" styleClass="listing-form-card-title"/>
                    <HBox spacing="10" fillHeight="true">
                        <VBox styleClass="listing-form-field" spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Max guests" styleClass="listing-form-label"/>
                            <TextField fx:id="maxGuestsField" promptText="e.g. 4"/>
                        </VBox>
                        <VBox styleClass="listing-form-field" spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Bedrooms" styleClass="listing-form-label"/>
                            <TextField fx:id="bedroomsField" promptText="e.g. 2"/>
                        </VBox>
                    </HBox>
                    <HBox spacing="10" fillHeight="true">
                        <VBox styleClass="listing-form-field" spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Bathrooms" styleClass="listing-form-label"/>
                            <TextField fx:id="bathroomsField" promptText="e.g. 1"/>
                        </VBox>
                        <VBox styleClass="listing-form-field" spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Rate / night ($)" styleClass="listing-form-label"/>
                            <TextField fx:id="rateField" promptText="e.g. 120.00"/>
                        </VBox>
                    </HBox>
                    <HBox spacing="10" fillHeight="true">
                        <VBox styleClass="listing-form-field" spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Check-in time" styleClass="listing-form-label"/>
                            <TextField fx:id="checkInField" promptText="e.g. 15:00"/>
                        </VBox>
                        <VBox styleClass="listing-form-field" spacing="4" HBox.hgrow="ALWAYS">
                            <Label text="Check-out time" styleClass="listing-form-label"/>
                            <TextField fx:id="checkOutField" promptText="e.g. 11:00"/>
                        </VBox>
                    </HBox>
                </VBox>

                <VBox styleClass="listing-form-card" spacing="8">
                    <HBox alignment="CENTER_LEFT" spacing="6">
                        <Label text="AMENITIES" styleClass="listing-form-card-title"/>
                        <Label text="Optional" styleClass="listing-form-card-subtitle"/>
                    </HBox>
                    <GridPane hgap="10" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50" hgrow="SOMETIMES"/>
                            <ColumnConstraints percentWidth="50" hgrow="SOMETIMES"/>
                        </columnConstraints>
                        <HBox styleClass="amenity-option" alignment="CENTER_LEFT" spacing="8"
                              GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <CheckBox fx:id="wifiBox" text="Wi-Fi" styleClass="agent-multi-option"/>
                        </HBox>
                        <HBox styleClass="amenity-option" alignment="CENTER_LEFT" spacing="8"
                              GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <CheckBox fx:id="parkingBox" text="Parking" styleClass="agent-multi-option"/>
                        </HBox>
                        <HBox styleClass="amenity-option" alignment="CENTER_LEFT" spacing="8"
                              GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <CheckBox fx:id="airConditioningBox" text="Air conditioning" styleClass="agent-multi-option"/>
                        </HBox>
                        <HBox styleClass="amenity-option" alignment="CENTER_LEFT" spacing="8"
                              GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <CheckBox fx:id="kitchenBox" text="Kitchen" styleClass="agent-multi-option"/>
                        </HBox>
                        <HBox styleClass="amenity-option" alignment="CENTER_LEFT" spacing="8"
                              GridPane.columnIndex="0" GridPane.rowIndex="2">
                            <CheckBox fx:id="washerBox" text="Washer" styleClass="agent-multi-option"/>
                        </HBox>
                        <HBox styleClass="amenity-option" alignment="CENTER_LEFT" spacing="8"
                              GridPane.columnIndex="1" GridPane.rowIndex="2">
                            <CheckBox fx:id="workDeskBox" text="Work desk" styleClass="agent-multi-option"/>
                        </HBox>
                    </GridPane>
                </VBox>
                </VBox>
            </GridPane>

            <HBox alignment="CENTER_LEFT" spacing="10" styleClass="listing-form-actions">
                <Button fx:id="saveButton" text="Create listing" onAction="#handleSave"
                        styleClass="listing-form-action"/>
                <Button text="Cancel" onAction="#handleBack"
                        styleClass="outline-button, listing-form-action"/>
                <Label fx:id="errorLabel" styleClass="form-error" wrapText="true"/>
            </HBox>
        </VBox>
    </content>
</ScrollPane>
