<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.CheckBox?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="listing-form-scroll"
            fx:controller="com.snoozeshare.ui.host.listings.HostListingFormController"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1">
    <content>
        <VBox fx:id="formRoot" styleClass="listing-form-page" spacing="16">
            <padding><Insets top="24" right="32" bottom="24" left="32"/></padding>

            <HBox alignment="CENTER_LEFT" spacing="16">
                <Button text="Back" onAction="#handleBack" styleClass="outline-button"/>
                <Label fx:id="formTitle" text="Create listing" styleClass="page-title"/>
            </HBox>

            <GridPane hgap="16" vgap="16" styleClass="listing-form-grid" maxWidth="Infinity">
                <columnConstraints>
                    <ColumnConstraints percentWidth="50" hgrow="SOMETIMES"/>
                    <ColumnConstraints percentWidth="50" hgrow="SOMETIMES"/>
                </columnConstraints>

                <VBox styleClass="listing-form-card" spacing="12" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <Label text="Basic details" styleClass="listing-form-card-title"/>
                    <Label text="Title" styleClass="listing-form-label"/>
                    <TextField fx:id="titleField" promptText="e.g. Bright city apartment"/>
                    <Label text="Description" styleClass="listing-form-label"/>
                    <TextField fx:id="descriptionField" styleClass="listing-description"
                               promptText="Describe the space" prefHeight="48"/>
                    <HBox spacing="12" fillHeight="true">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Property type" styleClass="listing-form-label"/>
                            <ComboBox fx:id="propertyTypeCombo" maxWidth="Infinity"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Status" styleClass="listing-form-label"/>
                            <ComboBox fx:id="statusCombo" maxWidth="Infinity"/>
                        </VBox>
                    </HBox>
                </VBox>

                <VBox styleClass="listing-form-card" spacing="12" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <Label text="Location" styleClass="listing-form-card-title"/>
                    <Label text="Street address" styleClass="listing-form-label"/>
                    <TextField fx:id="streetAddressField" promptText="Street address"/>
                    <HBox spacing="12" fillHeight="true">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="City" styleClass="listing-form-label"/>
                            <TextField fx:id="cityField" promptText="City"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Region" styleClass="listing-form-label"/>
                            <TextField fx:id="regionField" promptText="Region"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Postal code" styleClass="listing-form-label"/>
                            <TextField fx:id="postalCodeField" promptText="Postal code"/>
                        </VBox>
                    </HBox>
                </VBox>

                <VBox styleClass="listing-form-card" spacing="12" GridPane.columnIndex="1" GridPane.rowIndex="0">
                    <Label text="Capacity &amp; Pricing" styleClass="listing-form-card-title"/>
                    <HBox spacing="12" fillHeight="true">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Max guests" styleClass="listing-form-label"/>
                            <TextField fx:id="maxGuestsField" promptText="e.g. 4"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Bedrooms" styleClass="listing-form-label"/>
                            <TextField fx:id="bedroomsField" promptText="e.g. 2"/>
                        </VBox>
                    </HBox>
                    <HBox spacing="12" fillHeight="true">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Bathrooms" styleClass="listing-form-label"/>
                            <TextField fx:id="bathroomsField" promptText="e.g. 1.5"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Rate / night ($)" styleClass="listing-form-label"/>
                            <TextField fx:id="rateField" promptText="SGD"/>
                        </VBox>
                    </HBox>
                    <HBox spacing="12" fillHeight="true">
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Check-in time" styleClass="listing-form-label"/>
                            <TextField fx:id="checkInField" promptText="HH:mm"/>
                        </VBox>
                        <VBox spacing="6" HBox.hgrow="ALWAYS">
                            <Label text="Check-out time" styleClass="listing-form-label"/>
                            <TextField fx:id="checkOutField" promptText="HH:mm"/>
                        </VBox>
                    </HBox>
                </VBox>

                <VBox styleClass="listing-form-card" spacing="12" GridPane.columnIndex="1" GridPane.rowIndex="1">
                    <Label text="Amenities" styleClass="listing-form-card-title"/>
                    <GridPane hgap="10" vgap="10">
                        <columnConstraints>
                            <ColumnConstraints percentWidth="50" hgrow="SOMETIMES"/>
                            <ColumnConstraints percentWidth="50" hgrow="SOMETIMES"/>
                        </columnConstraints>
                        <HBox styleClass="amenity-option" alignment="CENTER_LEFT" spacing="8"
                              GridPane.columnIndex="0" GridPane.rowIndex="0">
                            <CheckBox fx:id="wifiBox" text="Wi-Fi"/>
                        </HBox>
                        <HBox styleClass="amenity-option" alignment="CENTER_LEFT" spacing="8"
                              GridPane.columnIndex="1" GridPane.rowIndex="0">
                            <CheckBox fx:id="parkingBox" text="Parking"/>
                        </HBox>
                        <HBox styleClass="amenity-option" alignment="CENTER_LEFT" spacing="8"
                              GridPane.columnIndex="0" GridPane.rowIndex="1">
                            <CheckBox fx:id="airConditioningBox" text="Air conditioning"/>
                        </HBox>
                        <HBox styleClass="amenity-option" alignment="CENTER_LEFT" spacing="8"
                              GridPane.columnIndex="1" GridPane.rowIndex="1">
                            <CheckBox fx:id="kitchenBox" text="Kitchen"/>
                        </HBox>
                        <HBox styleClass="amenity-option" alignment="CENTER_LEFT" spacing="8"
                              GridPane.columnIndex="0" GridPane.rowIndex="2">
                            <CheckBox fx:id="washerBox" text="Washer"/>
                        </HBox>
                        <HBox styleClass="amenity-option" alignment="CENTER_LEFT" spacing="8"
                              GridPane.columnIndex="1" GridPane.rowIndex="2">
                            <CheckBox fx:id="workDeskBox" text="Work desk"/>
                        </HBox>
                    </GridPane>
                </VBox>
            </GridPane>

            <Label fx:id="errorLabel" styleClass="form-error" wrapText="true"/>
            <HBox alignment="CENTER_RIGHT" spacing="10">
                <Button fx:id="saveButton" text="Create listing" onAction="#handleSave"
                        styleClass="listing-form-action"/>
                <Button text="Cancel" onAction="#handleBack"
                        styleClass="outline-button, listing-form-action"/>
            </HBox>
        </VBox>
    </content>
</ScrollPane>
