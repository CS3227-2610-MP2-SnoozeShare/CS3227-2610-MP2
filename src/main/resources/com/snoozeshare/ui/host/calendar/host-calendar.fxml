<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.RowConstraints?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import java.net.URL?>
<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.snoozeshare.ui.host.calendar.HostCalendarController"
      styleClass="agent-content, host-calendar-page calendar-content">
    <stylesheets><URL value="@../host-theme.css"/></stylesheets>
    <padding><Insets top="24" right="32" bottom="24" left="32"/></padding>
    <top>
        <HBox alignment="CENTER_LEFT" spacing="12">
            <padding><Insets top="0" right="0" bottom="0" left="0"/></padding>
            <Hyperlink text="Listings" onAction="#handleBack" styleClass="host-crumb-link"/>
            <Label text="›" styleClass="host-crumb"/>
            <Hyperlink fx:id="listingCrumb" onAction="#handleListingDetail" styleClass="host-crumb-link"/>
            <Label text="›" styleClass="host-crumb"/>
            <Label text="Booking Calendar" styleClass="host-crumb-current"/>
        </HBox>
    </top>
    <center>
        <HBox styleClass="calendar-content-row" spacing="20">
          <VBox styleClass="calendar-main" spacing="10" HBox.hgrow="ALWAYS">
            <padding><Insets top="20" right="24" bottom="24" left="8"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="12" styleClass="calendar-month-header">
                <HBox alignment="CENTER_LEFT" spacing="12">
                    <Button text="‹" styleClass="calendar-nav-button" accessibleText="Previous month" onAction="#handlePreviousMonth"
                            style="-fx-background-color: #ffffff; -fx-background-radius: 8px; -fx-border-color: #c0a080; -fx-border-radius: 8px; -fx-text-fill: #381a10; -fx-font-weight: normal;"/>
                    <Label fx:id="monthLabel" text="Month Year" styleClass="calendar-month-label"/>
                    <Button text="›" styleClass="calendar-nav-button" accessibleText="Next month" onAction="#handleNextMonth"
                            style="-fx-background-color: #ffffff; -fx-background-radius: 8px; -fx-border-color: #c0a080; -fx-border-radius: 8px; -fx-text-fill: #381a10; -fx-font-weight: normal;"/>
                </HBox>
                <Region HBox.hgrow="ALWAYS"/>
                <HBox alignment="CENTER_RIGHT" styleClass="calendar-legend" spacing="10">
                    <HBox alignment="CENTER_LEFT" spacing="4" styleClass="legend-item">
                        <Region styleClass="legend-swatch legend-swatch-available"
                                style="-fx-min-width: 14px; -fx-pref-width: 14px; -fx-max-width: 14px; -fx-min-height: 14px; -fx-pref-height: 14px; -fx-max-height: 14px; -fx-background-color: #ffffff; -fx-border-color: #40680c; -fx-border-width: 1px; -fx-background-radius: 4px; -fx-border-radius: 4px;"/>
                        <Label text="Available"/>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="4" styleClass="legend-item">
                        <Region styleClass="legend-swatch legend-swatch-booked"
                                style="-fx-min-width: 14px; -fx-pref-width: 14px; -fx-max-width: 14px; -fx-min-height: 14px; -fx-pref-height: 14px; -fx-max-height: 14px; -fx-background-color: #e8f8d0; -fx-border-color: #40680c; -fx-border-width: 1px; -fx-background-radius: 4px; -fx-border-radius: 4px;"/>
                        <Label text="Booked"/>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="4" styleClass="legend-item">
                        <Region styleClass="legend-swatch legend-swatch-blocked"
                                style="-fx-min-width: 14px; -fx-pref-width: 14px; -fx-max-width: 14px; -fx-min-height: 14px; -fx-pref-height: 14px; -fx-max-height: 14px; -fx-background-color: #fcd8da; -fx-border-color: #980c1c; -fx-border-width: 1px; -fx-background-radius: 4px; -fx-border-radius: 4px;"/>
                        <Label text="Blocked"/>
                    </HBox>
                    <HBox alignment="CENTER_LEFT" spacing="4" styleClass="legend-item">
                        <Region styleClass="legend-swatch legend-swatch-other-month"
                                style="-fx-min-width: 14px; -fx-pref-width: 14px; -fx-max-width: 14px; -fx-min-height: 14px; -fx-pref-height: 14px; -fx-max-height: 14px; -fx-background-color: rgba(16,6,4,0.15); -fx-border-color: #c0a080; -fx-border-width: 1px; -fx-background-radius: 4px; -fx-border-radius: 4px;"/>
                        <Label text="Other month"/>
                    </HBox>
                </HBox>
            </HBox>
            <GridPane fx:id="calendarGrid" styleClass="calendar-grid" VBox.vgrow="ALWAYS">
                    <columnConstraints>
                        <ColumnConstraints percentWidth="14.2857"/><ColumnConstraints percentWidth="14.2857"/>
                        <ColumnConstraints percentWidth="14.2857"/><ColumnConstraints percentWidth="14.2857"/>
                        <ColumnConstraints percentWidth="14.2857"/><ColumnConstraints percentWidth="14.2857"/>
                        <ColumnConstraints percentWidth="14.2857"/>
                    </columnConstraints>
                <rowConstraints>
                    <RowConstraints percentHeight="10"/>
                    <RowConstraints percentHeight="15"/><RowConstraints percentHeight="15"/>
                    <RowConstraints percentHeight="15"/><RowConstraints percentHeight="15"/>
                    <RowConstraints percentHeight="15"/><RowConstraints percentHeight="15"/>
                </rowConstraints>
            </GridPane>
          </VBox>
          <VBox styleClass="calendar-side-panel" spacing="8" minWidth="340" prefWidth="340" maxWidth="340"
                style="-fx-background-color: #ffffff; -fx-background-radius: 12px; -fx-border-color: #d8c4a8; -fx-border-width: 1px; -fx-border-radius: 12px;">
                <Label text="Block dates" styleClass="card-title"/>
                <VBox styleClass="calendar-input-group" spacing="4">
                    <Label text="From" styleClass="small"/>
                    <DatePicker fx:id="fromPicker" maxWidth="Infinity"/>
                </VBox>
                <VBox styleClass="calendar-input-group" spacing="4">
                    <Label text="To" styleClass="small"/>
                    <DatePicker fx:id="toPicker" maxWidth="Infinity"/>
                </VBox>
                <VBox styleClass="calendar-input-group" spacing="4">
                    <Label text="Reason" styleClass="small"/>
                    <TextField fx:id="reasonField" styleClass="calendar-filter-field"
                               promptText="e.g. personal use"/>
                </VBox>
                <Button text="Block these dates" styleClass="button" onAction="#handleBlockDates"/>
                <Label fx:id="statusLabel" styleClass="form-error" wrapText="true"/>
                <Separator styleClass="calendar-section-divider"/>
                <Label text="Current blocked dates" styleClass="card-title"/>
                <ScrollPane fitToWidth="true" minHeight="0" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" VBox.vgrow="ALWAYS">
                    <content><VBox fx:id="overridesContainer" spacing="8"/></content>
                </ScrollPane>
          </VBox>
        </HBox>
    </center>
</BorderPane>
