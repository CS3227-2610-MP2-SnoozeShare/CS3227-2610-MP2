<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" styleClass="agent-content" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.snoozeshare.ui.host.bookings.HostBookingsController">
    <padding><Insets top="24" right="32" bottom="24" left="32"/></padding>
    <HBox spacing="10" alignment="CENTER_LEFT">
        <Label text="Booking requests" styleClass="page-title"/>
        <Label fx:id="pendingCountLabel" text="0 pending" styleClass="badge-warning, agent-count-pill"/>
        <Region HBox.hgrow="ALWAYS"/>
    </HBox>
    <VBox styleClass="agent-card">
        <TableView fx:id="pendingTable" styleClass="agent-table" prefHeight="220">
            <columns>
                <TableColumn fx:id="pendingGuestColumn" text="Guest" prefWidth="125"/>
                <TableColumn fx:id="pendingListingColumn" text="Listing" prefWidth="150"/>
                <TableColumn fx:id="pendingDatesColumn" text="Dates" prefWidth="110"/>
                <TableColumn fx:id="pendingNightsColumn" text="Nights" prefWidth="70"/>
                <TableColumn fx:id="pendingGrossColumn" text="Gross" prefWidth="105"/>
                <TableColumn fx:id="pendingNetColumn" text="Net earning" prefWidth="120"/>
                <TableColumn fx:id="pendingRatingColumn" text="Guest rating" prefWidth="125"/>
                <TableColumn fx:id="pendingActionColumn" text="Action" prefWidth="190"/>
            </columns>
        </TableView>
    </VBox>
    <Label fx:id="feedbackLabel" styleClass="small"/>
    <Label text="Net earning = gross - 3% platform fee. Guest rating is their average review score, or No ratings yet."
           styleClass="small" wrapText="true"/>
    <Label text="Past requests" styleClass="section-title"/>
    <VBox styleClass="agent-card">
        <TableView fx:id="pastTable" styleClass="agent-table" prefHeight="180">
            <columns>
                <TableColumn fx:id="pastGuestColumn" text="Guest" prefWidth="150"/>
                <TableColumn fx:id="pastListingColumn" text="Listing" prefWidth="190"/>
                <TableColumn fx:id="pastDatesColumn" text="Dates" prefWidth="130"/>
                <TableColumn fx:id="pastNightsColumn" text="Nights" prefWidth="90"/>
                <TableColumn fx:id="pastTotalColumn" text="Total" prefWidth="130"/>
                <TableColumn fx:id="pastStatusColumn" text="Status" prefWidth="150"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
