<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<BorderPane fx:id="shellRoot" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.snoozeshare.ui.host.HostShellController" minWidth="1280" minHeight="800">
    <top><HBox styleClass="header" spacing="24" alignment="CENTER_LEFT"><Label text="SnoozeShare" styleClass="app-title"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="walletAmount" text="SGD 0.00" styleClass="wallet-amount"/><Label fx:id="roleLabel" text="Host"/></HBox></top>
    <left><VBox styleClass="sidebar" spacing="12"><Label text="Listings" styleClass="nav-item" onMouseClicked="#showListings"/><Label text="Bookings" styleClass="nav-item" onMouseClicked="#showBookings"/><Label text="Messages" styleClass="nav-item"/><Label text="Wallet" styleClass="nav-item" onMouseClicked="#showWallet"/><Button text="Log out" styleClass="outline-button" onAction="#logout"/></VBox></left>
    <center><VBox fx:id="contentRoot" styleClass="content" spacing="16"><Label fx:id="pageTitle" text="Listings" styleClass="page-title"/><Label fx:id="pageMessage" text="Manage your properties and listing status."/><StackPane fx:id="contentPane" VBox.vgrow="ALWAYS"/></VBox></center>
</BorderPane>
