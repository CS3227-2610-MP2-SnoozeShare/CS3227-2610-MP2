<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" minWidth="460" prefWidth="460" maxWidth="460" maxHeight="-Infinity"
      styleClass="guest-modal"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.snoozeshare.ui.guest.trips.CancelBookingDialogController">
    <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>

    <VBox spacing="4">
        <Label text="Cancel this booking?" styleClass="guest-modal-title"/>
        <Label fx:id="summaryLabel" styleClass="guest-trip-subtitle"/>
    </VBox>

    <VBox spacing="4" alignment="CENTER" styleClass="guest-refund-banner">
        <Label fx:id="refundCaption" styleClass="guest-refund-caption" wrapText="true"/>
        <Label fx:id="refundAmount" styleClass="guest-refund-amount"/>
        <Label text="Credited back to your wallet immediately" styleClass="guest-refund-note"/>
    </VBox>

    <Label text="Cancellation policy: 100% refund more than 48 hours before check-in, 50% refund within 48 hours."
           wrapText="true" styleClass="guest-policy-note"/>

    <Label fx:id="statusLabel" styleClass="error-message" wrapText="true" visible="false" managed="false"/>

    <HBox spacing="8" alignment="CENTER_RIGHT">
        <Region HBox.hgrow="ALWAYS"/>
        <Button text="Keep booking" styleClass="guest-dialog-secondary" onAction="#handleKeep"/>
        <Button fx:id="confirmButton" text="Confirm cancel" styleClass="guest-dialog-danger"
                onAction="#handleConfirm"/>
    </HBox>
</VBox>
