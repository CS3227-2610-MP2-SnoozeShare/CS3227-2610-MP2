<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<VBox spacing="16" maxWidth="400" styleClass="detail-modal"
      xmlns:fx="http://javafx.com/fxml"
      fx:controller="com.snoozeshare.ui.guest.wallet.WalletActionDialogController">
    <padding><Insets top="24" right="24" bottom="24" left="24"/></padding>

    <Label fx:id="titleLabel" text="Wallet Action" styleClass="page-title"/>
    <Label fx:id="currentBalanceLabel" text="Current balance: SGD 0.00" styleClass="small"/>

    <TextField fx:id="amountField" promptText="Enter amount (SGD)"/>

    <Label fx:id="statusLabel" styleClass="error-message" visible="false" managed="false"/>

    <HBox spacing="12">
        <Button fx:id="actionButton" text="Confirm" styleClass="button" onAction="#handleAction"/>
        <Button text="Cancel" styleClass="outline-button" onAction="#handleCancel"/>
    </HBox>
</VBox>
