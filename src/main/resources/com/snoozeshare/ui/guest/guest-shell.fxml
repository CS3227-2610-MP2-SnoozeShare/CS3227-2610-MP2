<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<BorderPane fx:id="shellRoot" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.snoozeshare.ui.guest.GuestShellController" minWidth="1280" minHeight="800">
    <top><HBox styleClass="header" spacing="24" alignment="CENTER_LEFT"><Label text="SnoozeShare" styleClass="app-title"/><Region HBox.hgrow="ALWAYS"/><Label fx:id="roleLabel" text="Guest"/></HBox></top>
    <left><VBox styleClass="sidebar" spacing="12"><Label text="Explore" styleClass="nav-item" onMouseClicked="#showExplore"/><Label text="My Trips" styleClass="nav-item" onMouseClicked="#showMyTrips"/><Label text="Wallet" styleClass="nav-item" onMouseClicked="#showWallet"/><Label text="Support" styleClass="nav-item" onMouseClicked="#showSupport"/><Button text="Log out" styleClass="outline-button" onAction="#logout"/></VBox></left>
    <center><VBox styleClass="content" spacing="16"><Label fx:id="pageTitle" text="Explore" styleClass="page-title"/><Label fx:id="pageMessage" text="Browse available stays and discover your next trip."/></VBox></center>
    <right><VBox styleClass="wallet-panel" spacing="10"><Label fx:id="walletTitle" text="Wallet" styleClass="page-title"/><Label fx:id="walletAmount" text="SGD 0.00" styleClass="wallet-amount"/></VBox></right>
</BorderPane>
